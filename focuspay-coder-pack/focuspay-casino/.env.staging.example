# Autonomous FocusCasino staging only. Do not copy production values into this file.
ENVIRONMENT=staging
# Self-serve SBP/card for QA. Unset still means on because ENVIRONMENT=staging.
DEPOSITS_ENABLED=1

# Inject the test token through the staging secret store. This configuration must not start polling.
BOT_TOKEN=REPLACE_WITH_TEST_BOT_TOKEN
BOT_USERNAME=focuscasino_staging_bot
CASINO_STAGING_TELEGRAM_BOT_USERNAME=focuscasino_staging_bot
CASINO_STAGING_TELEGRAM_BOT_ID=100000002

# In-container FocusPay staging API and matching internal secret confirmation.
FOCUSPAY_API_URL=http://backend:8000
FOCUSPAY_INTERNAL_TOKEN=REPLACE_WITH_STAGING_INTERNAL_API_SECRET
STAGING_INTERNAL_API_SECRET=REPLACE_WITH_STAGING_INTERNAL_API_SECRET
CASINO_EXCHANGER_ID=1001

# Staging-only callback endpoint and synthetic Telegram identities.
WEBHOOK_URL=http://casino-bot:8001/webhook
WEBHOOK_PORT=8001
# Human-facing fairness page via the staging SSH tunnel. Not production.
CASINO_FAIRNESS_URL=http://127.0.0.1:18081/casino/fairness
# Mini App URL is derived as <origin>/casino/tg unless CASINO_MINIAPP_URL is set.
GAME_CHAT_ID=-1000000000001
ALLOWED_CHAT_ID=-1000000000001
ADMIN_IDS=100000003
LOG_LEVEL=INFO

# Not used in the minimal PvP/recovery contour; keep distinct placeholders if a later test needs them.
FOCUSPAY_EXCHANGER_API_KEY=REPLACE_WITH_STAGING_EXCHANGER_KEY
FOCUSPAY_EXCHANGER_SECRET=REPLACE_WITH_STAGING_EXCHANGER_SECRET
