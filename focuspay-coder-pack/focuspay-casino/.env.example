# Telegram Bot
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=focuscasino_bot

# FocusPay Integration
FOCUSPAY_API_URL=https://focuspay.org
FOCUSPAY_INTERNAL_TOKEN=your_internal_api_secret_here

# FocusPay Exchanger API (HMAC)
FOCUSPAY_EXCHANGER_API_KEY=your_exchanger_api_key_here
FOCUSPAY_EXCHANGER_SECRET=your_exchanger_secret_here

# Webhook (для callback-ов от FocusPay)
WEBHOOK_URL=https://casino.focuspay.org/webhook
WEBHOOK_PORT=8001

# Игровой чат
GAME_CHAT_ID=-1001234567890
ALLOWED_CHAT_ID=-1001234567890  # Чат для PVP игр (обычно тот же, что GAME_CHAT_ID)

# Админы (Telegram IDs через запятую)
ADMIN_IDS=123456789,987654321

# Логирование
LOG_LEVEL=INFO

# Self-serve SBP/card. Production must stay 0. Staging defaults on via ENVIRONMENT=staging.
DEPOSITS_ENABLED=0

# Страница проверки карт (абсолютный URL для ссылки в Telegram)
CASINO_FAIRNESS_URL=
