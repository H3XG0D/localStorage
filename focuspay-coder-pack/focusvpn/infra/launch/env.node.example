# Node agent — copy to /etc/focusvpn/agent.env (root:focusvpn 0640)
AGENT_NODE_ID=aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa
AGENT_CP_URL=https://api.example.com:8443
# First boot only (from `make seed-agent-token` on CP):
# AGENT_NODE_TOKEN=
AGENT_CERT_FILE=/etc/focusvpn/secrets/agent.crt
AGENT_KEY_FILE=/etc/focusvpn/secrets/agent.key
AGENT_CA_FILE=/etc/focusvpn/secrets/ca.crt
AGENT_INTERFACE=awg0
AGENT_POLL_INTERVAL=5s
AGENT_TELEMETRY_INTERVAL=15s
