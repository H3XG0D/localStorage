# Control plane — copy to /etc/focusvpn/env (root:focusvpn 0640)
FOCUSVPN_HTTP_ADDR=127.0.0.1:8080
FOCUSVPN_AGENT_ADDR=0.0.0.0:8443
FOCUSVPN_STORE=postgres
FOCUSVPN_DATABASE_URL=postgres://focusvpn:CHANGE_ME@127.0.0.1:5432/focusvpn?sslmode=disable
FOCUSVPN_ALLOCATION_AUTO_ACTIVE=false
FOCUSVPN_SCHEDULER=true
FOCUSVPN_CONFIG_TTL=24h
# Generate once (openssl rand -base64 32) and keep offline backup:
# FOCUSVPN_JWT_ED25519_SEED=
# FOCUSVPN_TOKEN_HMAC_KEY=
# FOCUSVPN_CONFIG_SIGNING_SEED=
# FOCUSVPN_KEK=
# FOCUSVPN_KEK_ID=kek-v1
FOCUSVPN_AGENT_CA_CERT=/etc/focusvpn/secrets/ca.crt
FOCUSVPN_AGENT_CA_KEY=/etc/focusvpn/secrets/ca.key
FOCUSVPN_CONFIG_SIGNING_KEY_PATH=/etc/focusvpn/secrets/config_signing_seed
FOCUSVPN_KEK_PATH=/etc/focusvpn/secrets/kek
