# FocusVPN development environment (copy to .env; .env is gitignored).
# DEVELOPMENT-ONLY values. Production secrets come from a Secret Manager.
# Launch-L1: wizard writes `.env.launch` (also gitignored via .env.*) — do not reuse those values here.

# Control plane
FOCUSVPN_HTTP_ADDR=:8080

# Store selection: "memory" (tests/smoke) or "postgres" (real app path).
FOCUSVPN_STORE=postgres

# PostgreSQL (matches infra/compose/docker-compose.yml dev credentials).
FOCUSVPN_DATABASE_URL=postgres://focusvpn:focusvpn@localhost:5432/focusvpn?sslmode=disable

# Auth signing keys. If unset in dev, ephemeral keys are generated with a WARN.
# In production these MUST come from a Secret Manager (SECURITY.md §4.2).
# FOCUSVPN_JWT_ED25519_SEED=<base64 32-byte seed>
# FOCUSVPN_TOKEN_HMAC_KEY=<base64 >=32 bytes>

# ConfigParts signing (distinct from JWT). File default: secrets/config_signing_seed
# FOCUSVPN_CONFIG_SIGNING_SEED=<base64 32-byte seed>
# FOCUSVPN_CONFIG_SIGNING_KEY_PATH=secrets/config_signing_seed

# Envelope KEK (AES-256). File default: secrets/kek
# FOCUSVPN_KEK=<base64 32 bytes>
# FOCUSVPN_KEK_PATH=secrets/kek
# FOCUSVPN_KEK_ID=kek-v1

# A1 DEV stub: skip agent confirm (pending→active). Must be false in production / M4+.
FOCUSVPN_ALLOCATION_AUTO_ACTIVE=true

# P4-M5: config TTL re-issue (scheduler). Set FOCUSVPN_SCHEDULER=off to disable.
# FOCUSVPN_SCHEDULER=true
# FOCUSVPN_SCHEDULER_INTERVAL=1m
# FOCUSVPN_CONFIG_TTL=24h

# E1: shared token for VPN bot / FocusPay federation (ADR-007).
# FOCUSVPN_INTERNAL_TOKEN=dev-internal-token

# E2: Telegram app login deep links (ADR-008).
# FOCUSVPN_TELEGRAM_BOT_USERNAME=FocusVPNBot
# FOCUSVPN_APP_LOGIN_TTL=5m

# Public origin for Happ subscription links (no trailing slash).
# FOCUSVPN_PUBLIC_BASE=https://focuspay.org/vpn-api

# Integration tests run against real PostgreSQL only when this is set:
# FOCUSVPN_TEST_DATABASE_URL=postgres://focusvpn:focusvpn@localhost:5432/focusvpn_test?sslmode=disable
