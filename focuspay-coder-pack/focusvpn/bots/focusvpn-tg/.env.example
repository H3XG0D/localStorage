# FocusVPN Telegram bot (copy to .env — do not commit secrets)

TELEGRAM_BOT_TOKEN=
FOCUSPAY_API_BASE=http://127.0.0.1:8081
FOCUSPAY_INTERNAL_TOKEN=dev-shared-token
FOCUSVPN_API_BASE=http://127.0.0.1:8080
FOCUSVPN_INTERNAL_TOKEN=dev-shared-token
