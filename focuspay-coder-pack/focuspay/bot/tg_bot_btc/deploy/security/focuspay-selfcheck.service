[Unit]
Description=FocusPay defensive self-check (origin smoke; SAST is focuspay-sast-selfcheck.timer)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
# HTTP hairpin probe only. Nightly bandit/pip-audit: focuspay-sast-selfcheck.timer
# (absolute bins, fail-closed). Keep SELFCHECK_SAST=0 to avoid a second PATH lookup.
EnvironmentFile=-/etc/focuspay/selfcheck.env
EnvironmentFile=-/opt/exchange-backend/.env
ExecStart=/opt/exchange-backend/venv/bin/python /opt/tg_bot_btc/deploy/security/focuspay-selfcheck.py
Restart=always
RestartSec=20

[Install]
WantedBy=multi-user.target
