[Unit]
Description=FocusPay secret rotation readiness check (non-mutating)
ConditionPathExists=/opt/tg_bot_btc/.env
ConditionPathExists=/opt/tg_bot_btc/scripts/rotate_secrets.sh

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/tg_bot_btc
ExecStart=/usr/bin/env /opt/tg_bot_btc/scripts/rotate_secrets.sh --dry-run
UMask=0077
TimeoutStartSec=60
PrivateTmp=yes
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
LockPersonality=yes
MemoryDenyWriteExecute=yes
StandardOutput=journal
StandardError=journal
