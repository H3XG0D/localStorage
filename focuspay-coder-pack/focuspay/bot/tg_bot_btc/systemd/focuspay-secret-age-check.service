[Unit]
Description=FocusPay secret age check
ConditionPathExists=/opt/tg_bot_btc/.env
ConditionPathExists=/opt/tg_bot_btc/scripts/check_secret_age.sh

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/tg_bot_btc
ExecStart=/usr/bin/env /opt/tg_bot_btc/scripts/check_secret_age.sh --alert
UMask=0077
TimeoutStartSec=60
PrivateTmp=yes
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/tg_bot_btc
LockPersonality=yes
MemoryDenyWriteExecute=yes
StandardOutput=journal
StandardError=journal
