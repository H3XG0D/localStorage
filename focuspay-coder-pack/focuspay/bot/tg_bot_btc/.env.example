# Скопируйте в .env на сервере и задайте свои значения. Не коммитьте .env.

TELEGRAM_BOT_TOKEN=
# Токен @focusvpn1_bot: итог модерации отзыва VPN уходит в чат этого бота, не в обменник.
FOCUSVPN_BOT_TOKEN=
# Каталог скринов отзывов VPN. Тот же путь у API и у этого бота.
# VPN_REVIEW_PHOTO_DIR=/var/lib/focuspay/vpn-review-photos
# Отдельный бот антиспама в focus-чате (polling). Не коммитить токен.
TELEGRAM_ANTISPAM_BOT_TOKEN=
# Аккаунт (не бот) для авточистки focus-чата: удалённые и «был давно».
# api_id / api_hash — https://my.telegram.org. Сессию создаёт scripts/focusclear_user_login.py.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# FOCUSCLEAR_USER_SESSION=/var/lib/focuspay/focusclear_user.session
# Опрос наличия реквизитов: тем же аккаунтом шлём /reki боту и парсим коридоры сумм.
# Без REKI_BOT_PEER джоб не стартует. REKI_USER_SESSION — если нужен отдельный аккаунт.
# REKI_BOT_PEER=
# REKI_USER_SESSION=/var/lib/focuspay/reki_user.session
# REKI_POLL_SECONDS=120
# REKI_SNAPSHOT_TTL_SECONDS=300
# Staging must use a separate bot identity and isolated chats/endpoints. The bot exits
# before connecting if ENVIRONMENT=staging and any required STAGING_* value is missing.
# ENVIRONMENT=staging
# STAGING_TELEGRAM_BOT_USERNAME=focuspay_staging_bot
# STAGING_TELEGRAM_BOT_ID=
# TELEGRAM_BOT_USERNAME=focuspay_staging_bot
# TELEGRAM_BOT_ID=
# STAGING_ENABLE_SAFE_BACKGROUND_TASKS=0
# STAGING_POLLING_LOCK_PATH=/tmp/focuspay-staging-bot.polling.lock
# 1 = реквизиты в Mini App (+ fingerprint). 0/пусто = bill в чате (откат).
WEBAPP_REQUISITES=0
# Кнопка «Приложение» слева от поля ввода и «ОТКРЫТЬ» в списке чатов после /start.
# Только https:// — иначе обеих кнопок нет, обмен в чате остаётся.
# EXCHANGE_MINIAPP_URL=https://focuspay.org/exchange/tg
# Казино: кнопка меню чата и напоминание «Открыть FocusBet» после сообщения клиента.
# Только https://. Пусто — меню остаётся на обмене, напоминание не шлётся.
# CASINO_MINIAPP_URL=https://focuspay.org/casino
# Prod: webhook вместо polling (нет задержек из-за Conflict getUpdates)
TELEGRAM_WEBHOOK_URL=https://focuspay.org/bot/telegram
TELEGRAM_WEBHOOK_PATH=bot/telegram
TELEGRAM_WEBHOOK_PORT=8082
# Секрет для заголовка X-Telegram-Bot-Api-Secret-Token (openssl rand -hex 24)
TELEGRAM_WEBHOOK_SECRET=
# Группа операторов: заявки, чеки, оплата, кнопки «Выплачено» (группа «123»).
# Можно не задавать вручную: добавьте бота в группу и отправьте текст «123» от админа.
TELEGRAM_OPS_GROUP_ID=
# Группа внештатных заявок (кабинет внештатника, appeals PDF/видео/чек).
# Добавьте бота в группу «внештат» и отправьте /external от админа.
TELEGRAM_EXTERNAL_DEALS_GROUP_ID=
# Группа проверки клиентов (профиль / совпадение кошелька до реквизитов).
# Добавьте бота и отправьте /client_review от админа.
TELEGRAM_CLIENT_REVIEW_GROUP_ID=
# Топик/чат комиссий со свапов: добавьте бота в группу и отправьте «swap» в нужном топике от админа.
# Группа споров Payfast: видео-подтверждения оплаты ([СПОРЫ] Moonlight & payfast)
TELEGRAM_APPEALS_GROUP_ID=-5561953525
# Устаревший alias: если OPS не задан, берётся отсюда
TELEGRAM_ADMIN_GROUP_ID=
# Отчёты владельца (/dash, /pulse, /post) — может быть другая группа
TELEGRAM_REPORTS_GROUP_ID=
# Доп. ники для /dash /pulse /help в группе отчётов (без полного TELEGRAM_ADMIN_IDS)
TELEGRAM_REPORTS_USERNAMES=
TELEGRAM_ADMIN_IDS=1097952683,7869431717
# Владелец финансов (/dash, /pulse): @xdxdxdxddw
FINANCE_OWNER_TELEGRAM_ID=6900291997
# Устарело: если задано и нет TELEGRAM_REPORTS_GROUP_ID — только для fallback reports id
TELEGRAM_OWNER_GROUP_ID=
OWNER_STALE_PAYOUT_MINUTES=10
OWNER_MONITOR_INTERVAL_SEC=60
WEBHOOK_SECRET=
# Тот же секрет, что INTERNAL_API_SECRET в exchange-backend (бот → /api/internal/chat/*)
INTERNAL_API_SECRET=
EXCHANGE_API_URL=http://127.0.0.1:8000
# FocusPayPartnersBot: приходы p_CODE и активации купонов автора. Пусто — события не шлём.
# PARTNER_URL=http://127.0.0.1:8080
# TRACK_SECRET=
# Каталог фото чата (общий с exchange-backend)
CHAT_UPLOAD_DIR=/opt/tg_bot_btc/chat_uploads
EXPIRE_GRACE_SECONDS=120
# Сколько минут ждём чек/видео от клиента в AWAITING_CHECK. По умолчанию сутки.
RECEIPT_WAIT_WINDOW_MINUTES=1440
# TTL шага обмена в Telegram (сек). По умолчанию 1800 (30 мин).
# EXCHANGE_FSM_TTL_SEC=1800
# Файл persistence FSM (переживает перезапуск бота)
# BOT_PERSISTENCE_PATH=/opt/tg_bot_btc/data/bot_persistence.pkl
DB_POOL_MIN=2
DB_POOL_MAX=10
# Payfast Merchant API (https://payfast.website/api_merchant)
MERCHANT_BASE_URL=https://payfast.website/api_merchant
MERCHANT_API_KEY=
MERCHANT_SECRET_KEY=
# Числовой id_merchant из кабинета Payfast (проверка webhook §6.2). Рекомендуется на prod.
MERCHANT_ID=
MERCHANT_CALLBACK_URL=https://focuspay.org/callback

# finance666 — выплаты по QR СБП (оплата покупок с баланса клиента).
# Это выплатной рельс: рубли уходят получателю QR, списывается наш USDT-баланс мерчанта.
# Доступ по ключу + allowlist IP: отдайте менеджеру адрес прода, иначе будет 401.
FINANCE666_BASE_URL=https://api.finance666.com
FINANCE666_API_KEY=
# Секрет адреса вебхука из кабинета (целиком, вместе с префиксом whsec_). Выдаётся один раз.
FINANCE666_WEBHOOK_SECRET=
PUBLIC_SITE_URL=https://focuspay.org
# Username игрового бота FocusBet без @ (кнопка меню и ссылка после обмена). Прод: focusludka_bot.
CASINO_BOT_USERNAME=focusludka_bot
# Tor v3 (optional). Empty until hidden services are generated.
PUBLIC_ONION_URL=
DOLIV_ONION_URL=
MERCHANT_SUB_TOKEN=CARDRUB

# ОБЯЗАТЕЛЬНО в продакшене: IP-адреса webhook источников (через запятую).
# Payfast аутентифицирует callback через api_key + id_merchant в JSON-теле.
# ⚠️ SECURITY: Empty в проде = reject all webhooks. 127.0.0.1 разрешён для локальной разработки.
# Задайте IP Payfast или других провайдеров в проде!
# Пример: WEBHOOK_ALLOWED_IPS=185.71.67.10,185.71.67.11
WEBHOOK_ALLOWED_IPS=127.0.0.1
# Доверенные reverse proxy, от которых принимаются forwarded client-IP headers.
# CIDR поддерживается. При локальном nginx оставьте loopback; не задавайте 0.0.0.0/0 или ::/0.
WEBHOOK_TRUSTED_PROXIES=127.0.0.1,::1
# SECURITY: ОБЯЗАТЕЛЬНО задать в проде! Used for payment receipt signatures
RECEIPT_SECRET=CHANGE_ME_random_secret_for_receipts
# SECURITY: ОБЯЗАТЕЛЬНО задать в проде! Used for callback signatures
CALLBACK_SECRET=CHANGE_ME_random_secret_for_callbacks
DATABASE_DSN=postgresql://exchange_bot:PASSWORD@127.0.0.1:5432/exchange_bot

# JSON кошельки для sell-направления (обязательно на prod). Пример:
# Не используется: продажа (sell) только через оператора, авто-кошельки не нужны.
# SELL_WALLETS_JSON=

USER_REFERRAL_PERCENT=5.0
USER_CASHBACK_PERCENT=5.0

# Casino card/SBP withdraw. Same floor as cabinet and referral: 20000.
CASINO_MIN_WITHDRAW_CARD_RUB=20000
CASINO_WITHDRAW_FEE_CARD_RUB=100
CASINO_WITHDRAW_FEE_USD_BTC=2.5
CASINO_WITHDRAW_FEE_USD_LTC=2.5
CASINO_WITHDRAW_FEE_USD_TRX=2.5

# Вывод баланса в крипте: минимум ($, эквивалент по USDT/RUB)
USER_REFERRAL_MIN_WITHDRAW_CRYPTO_USD_BTC=5
USER_REFERRAL_MIN_WITHDRAW_CRYPTO_USD_LTC=5
USER_REFERRAL_MIN_WITHDRAW_CRYPTO_USD_TRX=5
USER_REFERRAL_MIN_WITHDRAW_CRYPTO_USD_USDT=20

# Комиссия сети при переводе крипты (вывод — с клиента; BUY — расход).
# BTC/LTC/TRX и карта: CASINO_WITHDRAW_FEE_*. USDT:
CRYPTO_NETWORK_FEE_USD_USDT=4

# Покупка BTC: ставка отправки берётся из mempool (signer, цель — следующий блок).
# До FREE_SAT_VB платит компания, превышение добавляется к сумме заявки.
# VSIZE с запасом (реальная tx бывает из нескольких входов), BUFFER — на рост
# ставки между выдачей реквизитов и отправкой, MAX_PCT — потолок на мелких заявках.
BUY_BTC_FEE_FREE_SAT_VB=2
BUY_BTC_FEE_VSIZE=200
BUY_BTC_FEE_BUFFER_PCT=20
BUY_BTC_FEE_MAX_PCT_OF_ORDER=3

# Отзыв после PAID: бонус на баланс, публикация ботом в канал
REVIEW_BONUS_TEXT_RUB=50
REVIEW_BONUS_PHOTO_RUB=100
# REVIEW_BONUS_RUB=50  # alias для TEXT
REVIEWS_CHANNEL_USERNAME=focuspayr
# Числовой chat_id канала (надёжнее @username). Бот — админ канала с правом постинга.
# Автоприём заявок: в канале включите «Approve new members»; бот — админ с can_invite_users.
# Привязка: /reviews в канале от админа, висящие заявки — /reviews_sync.
REVIEWS_PUBLISH_CHAT_ID=
REVIEWS_CHANNEL_URL=https://t.me/focuspayr
# Группа с включёнными «Темами». Админ пишет /review_topics — бот создаёт «VPN» и «Обмены».
# Одобренный отзыв копируется из канала в свою тему. Канал темы не поддерживает.
# Файл id тем: data/review_topics.json (или REVIEW_TOPICS_FILE).
# Публичный чат пользователей (invite-ссылка t.me/+...)
COMMUNITY_CHAT_URL=https://t.me/+It9i6n_8FUgwM2Nl
# ID focus чата для автоприёма заявок (или /community в группе от админа)
TELEGRAM_COMMUNITY_CHAT_ID=
# Новости проекта FocusPay (invite-ссылка)
NEWS_CHAT_URL=
# ID группы новостей для автоприёма заявок (или /news в группе от админа)
TELEGRAM_NEWS_CHAT_ID=

# News broadcast (opt-in only)
NEWS_BROADCAST_RATE_PER_MIN=30
NEWS_BROADCAST_FREQUENCY_HOURS=24
NEWS_BROADCAST_MAX_RECIPIENTS=50000

# ========================================
# Offsite Backup Configuration
# ========================================
# ВАЖНО: Настроить в проде для disaster recovery!
# Автоматический ежедневный pg_dump + rsync на внешний сервер

# Включить offsite backup (true/false)
OFFSITE_BACKUP_ENABLED=false

# Внешний backup сервер (hostname или IP)
OFFSITE_BACKUP_HOST=

# SSH пользователь на backup сервере
OFFSITE_BACKUP_USER=

# Путь к директории бэкапов на backup сервере
OFFSITE_BACKUP_PATH=

# SSH ключ для подключения (опционально, если не default ~/.ssh/id_rsa)
# Сгенерировать: ssh-keygen -t ed25519 -f /root/.ssh/backup_key -N ""
# Скопировать: ssh-copy-id -i /root/.ssh/backup_key.pub user@backup-server
OFFSITE_BACKUP_SSH_KEY=

# Пример настройки:
# OFFSITE_BACKUP_ENABLED=true
# OFFSITE_BACKUP_HOST=backup.example.com
# OFFSITE_BACKUP_USER=focuspay
# OFFSITE_BACKUP_PATH=/backups/focuspay
# OFFSITE_BACKUP_SSH_KEY=/root/.ssh/backup_key
