# Copy to .env.docker and replace every CHANGE_ME value before starting locally.
# This file is a template only. Never use these values on a public host.

POSTGRES_DB=exchange_bot
POSTGRES_USER=exchange_bot
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
DATABASE_DSN=postgresql://exchange_bot:CHANGE_ME_LOCAL_DB_PASSWORD@db:5432/exchange_bot

SECRET_KEY=CHANGE_ME_LOCAL_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=240
PUBLIC_SITE_URL=http://localhost:8080
PANEL_HTTP_ONLY_COOKIES=true
SECURITY_RATE_LIMIT_PER_MIN=120
SECURITY_ALERTS_ENABLED=false
EXPOSE_OPENAPI_DOCS=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_IDS=1000000000
ADMIN_TELEGRAM_IDS=1000000000
FINANCE_OWNER_TELEGRAM_ID=
TELEGRAM_OPS_GROUP_ID=
TELEGRAM_EXTERNAL_DEALS_GROUP_ID=
TELEGRAM_CLIENT_REVIEW_GROUP_ID=
TELEGRAM_REPORTS_GROUP_ID=
TELEGRAM_ADMIN_GROUP_ID=0
# Sticker set names for operator chat picker (comma-separated, getStickerSet)
OPERATOR_STICKER_SETS=FocusPay_by_focuspay1_bot
SECURITY_TELEGRAM_CHAT_ID=
SECURITY_TELEGRAM_USER_ID=

WEBHOOK_SECRET=CHANGE_ME_LOCAL_WEBHOOK_SECRET
RECEIPT_SECRET=CHANGE_ME_LOCAL_RECEIPT_SECRET
CALLBACK_SECRET=CHANGE_ME_LOCAL_CALLBACK_SECRET
INTERNAL_API_SECRET=CHANGE_ME_LOCAL_INTERNAL_SECRET
WEBHOOK_ALLOWED_IPS=

MERCHANT_BASE_URL=https://payfast.website/api_merchant
MERCHANT_API_KEY=
MERCHANT_SECRET_KEY=
MERCHANT_CALLBACK_URL=http://localhost:8080/callback
MERCHANT_SUB_TOKEN=CARDRUB
MERCHANT_ID=

# Polling is the safe local default. Set these only when using a reachable HTTPS URL.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_PATH=bot/telegram
TELEGRAM_WEBHOOK_LISTEN=0.0.0.0
TELEGRAM_WEBHOOK_PORT=8082

EXCHANGE_API_URL=http://backend:8000
TG_BOT_PATH=/opt/tg_bot_btc
RECEIPTS_DIR=/opt/tg_bot_btc/receipts
CHAT_UPLOAD_DIR=/opt/tg_bot_btc/chat_uploads
BOT_USER_AVATAR_DIR=/opt/tg_bot_btc/bot_user_avatars
OPERATOR_AVATAR_DIR=/opt/tg_bot_btc/operator_avatars
SECURITY_LOG_FILE=/var/log/focuspay/security.log
GEOIP_CITY_DB_PATH=
REDIS_URL=redis://redis:6379/0
DB_POOL_MIN=1
DB_POOL_MAX=5

FOCUSPAY_HTTP_PORT=8080
FOCUSPAY_DB_SEED_DUMP=./focuspay-main-site/tmp/focuspay-main-backup-20260804-044406/db/exchange_bot.dump
