# Local `npm run dev` only. Copy to `.env.local` (gitignored).
# Not bundled into the production frontend. Never used on focuspay.org.
#
# Vite attaches this session on localhost only and skips the panel login form.

FOCUSPAY_DEV_ADMIN_USER=
FOCUSPAY_DEV_ADMIN_PASSWORD=
# Base32 TOTP secret, or a one-off 6-digit code
FOCUSPAY_DEV_ADMIN_TOTP=
# Optional: paste a live admin JWT instead of logging in
# FOCUSPAY_DEV_ADMIN_TOKEN=

FOCUSPAY_DEV_OPERATOR_USER=
FOCUSPAY_DEV_OPERATOR_PASSWORD=
FOCUSPAY_DEV_OPERATOR_TOTP=
# FOCUSPAY_DEV_OPERATOR_TOKEN=

# Optional dump → .dev-week-snapshot.json (python scripts/dev_week_snapshot.py)
# FOCUSPAY_DEV_DUMP_DSN=host=127.0.0.1 port=55432 dbname=exchange_bot user=postgres password=localweek
# FOCUSPAY_DEV_DUMP_PATH=/path/to/exchange_bot.dump
