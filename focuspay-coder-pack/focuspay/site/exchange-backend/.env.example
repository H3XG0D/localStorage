DATABASE_DSN=postgresql://exchange_bot:777@127.0.0.1:5432/exchange_bot
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_very_long_secret_key_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=240

# Same bot as tg_bot_btc (for Telegram Login Widget hash verification)
TELEGRAM_BOT_TOKEN=
# Токен @focusvpn1_bot: сообщение «отзыв опубликован» уходит в чат VPN.
FOCUSVPN_BOT_TOKEN=
# Скрины отзывов VPN. Тот же путь, что у бота FocusPay.
# VPN_REVIEW_PHOTO_DIR=/var/lib/focuspay/vpn-review-photos
TELEGRAM_BOT_USERNAME=YourBotUsername
# SECURITY: ОБЯЗАТЕЛЬНО задать в проде! Empty = fail-secure (reject all webhooks)
WEBHOOK_SECRET=CHANGE_ME_random_secret_for_webhook_validation
INTERNAL_API_SECRET=
# FocusPayPartnersBot. Тот же TRACK_SECRET, что в /opt/focuspay-partner/.env.
# Партнёрка пишет купоны на POST /api/internal/partner-author-promos.
# PARTNER_URL=http://127.0.0.1:8080
# TRACK_SECRET=
# ID exchanger-аккаунта FocusCasino; пусто/0 блокирует зачисление casino-депозитов.
CASINO_EXCHANGER_ID=
# Username игрового бота без @ (панель /x8/casino/settings → «Игровой бот»).
CASINO_BOT_USERNAME=focusludka_bot
# Token of that same casino bot, used only to verify signed Mini App initData.
CASINO_TELEGRAM_BOT_TOKEN=
# SECURITY: ОБЯЗАТЕЛЬНО задать в проде! Used for payment receipt signatures
RECEIPT_SECRET=CHANGE_ME_random_secret_for_receipts
# SECURITY: ОБЯЗАТЕЛЬНО задать в проде! Used for callback signatures
CALLBACK_SECRET=CHANGE_ME_random_secret_for_callbacks
TG_BOT_PATH=/opt/tg_bot_btc

# Comma-separated Telegram user IDs allowed into /admin
ADMIN_TELEGRAM_IDS=1097952683,7869431717,6900291997,8718118115
FINANCE_OWNER_TELEGRAM_ID=

# Security access logging (GeoLite2-City + optional file log)
GEOIP_CITY_DB_PATH=/opt/exchange-backend/GeoLite2-City.mmdb
SECURITY_LOG_FILE=/var/log/focuspay/security.log
SECURITY_RATE_LIMIT_PER_MIN=120
# Опционально: Redis для rate limit при нескольких workers (иначе in-memory)
# Redis для rate limit и IP-бана при нескольких workers (рекомендуется на prod)
REDIS_URL=redis://127.0.0.1:6379/0
PANEL_HTTP_ONLY_COOKIES=true
SECURITY_IP_BAN_SCORE=70
SECURITY_IP_BAN_SEC=3600
# Не используется: sell только через оператора
# SELL_WALLETS_JSON=
SECURITY_ALERT_COOLDOWN_SEC=900
SECURITY_ALERTS_ENABLED=true
# Брутфорс: 15 неудачных входов за 5 минут → бан на час. Успешный вход сбрасывает счётчик.
# Старое значение 5 было слишком жёстким (ошибки пароля/TOTP банили легитимных юзеров).
SECURITY_AUTH_FAIL_THRESHOLD=15
SECURITY_AUTH_FAIL_WINDOW_SEC=300
# Доверенные IP (owner office, VPN exit) — никогда не банить, через запятую:
# SECURITY_TRUSTED_IPS=217.60.34.122,2403:6200:8871:6a71::/64
# Группа операторов: заявки, чеки, статусы (группа «123»)
TELEGRAM_OPS_GROUP_ID=
# Группа внештатных заявок (кабинет внештатника) — /external в tg_bot
TELEGRAM_EXTERNAL_DEALS_GROUP_ID=
TELEGRAM_REPORTS_GROUP_ID=
# Нужен для загрузки фото в рассылке (тот же ID, что TELEGRAM_ADMIN_GROUP_ID в tg_bot_btc)
TELEGRAM_ADMIN_GROUP_ID=
# Канал «FocusPay новости». Тот же ID, что TELEGRAM_NEWS_CHAT_ID у бота.
# Пусто — активная строка news_chat_allowlist.
TELEGRAM_NEWS_CHAT_ID=

# Только security-алерты (часто та же группа «123», но отдельная переменная):
SECURITY_TELEGRAM_CHAT_ID=
SECURITY_TELEGRAM_USER_ID=1097952683

# Doliv lab bridge (trader card payouts) — empty = disabled
# DOLIV_BRIDGE_URL=http://127.0.0.1:8002
# DOLIV_BRIDGE_KEY=

# Tor v3 mirrors (filled by deploy/setup-onion.sh on prod)
# PUBLIC_ONION_URL=http://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.onion
# DOLIV_ONION_URL=http://yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy.onion

# Локальная разработка: true. На prod оставить false (или не задавать).
EXPOSE_OPENAPI_DOCS=false

# Ops AI privacy / audit (no secrets)
OPS_AI_CONSENT_VERSION=ops-ai-privacy-v1
OPS_AI_AUDIT_TTL_DAYS=30
OPS_AI_ALLOW_IMAGES=false
OPS_AI_ALLOW_UI_CLIENT_PII=false
OPS_AI_ALLOW_ORDER_AMOUNTS=false

# Casino card/SBP withdraw. Same floor as cabinet and referral: 20000.
CASINO_MIN_WITHDRAW_CARD_RUB=20000
CASINO_WITHDRAW_FEE_CARD_RUB=100
CASINO_WITHDRAW_FEE_USD_BTC=2.5
CASINO_WITHDRAW_FEE_USD_LTC=2.5
CASINO_WITHDRAW_FEE_USD_TRX=2.5

# News broadcast limits (bot + API shared semantics)
NEWS_BROADCAST_RATE_PER_MIN=30
NEWS_BROADCAST_FREQUENCY_HOURS=24
NEWS_BROADCAST_MAX_RECIPIENTS=50000

# Leave empty: broadcasts send text/photo only (Telegram stickers are full-size).
BROADCAST_STICKER_SETS=
BROADCAST_AI_ENABLED=false
BROADCAST_AI_PROVIDER_ALLOWLIST=openai,openrouter,offline
BROADCAST_AI_MODEL_ALLOWLIST=
# Empty = current Ops AI / Lelouch chat model (OPS_AI_OPENAI_MODEL).
BROADCAST_AI_MODEL=
BROADCAST_AI_TIMEOUT_SEC=20
BROADCAST_AI_MAX_CHARS=4096

# Sticker AI (scaffold; keep disabled until explicit lab enable)
STICKER_AI_ENABLED=false
# Lab only: allow create/generate/approve/publish HTTP. Requires ENABLED=true.
# lelouch = reuse OPS_AI_OPENAI_* (do not duplicate the token here).
STICKER_AI_MUTATIONS_ENABLED=false
STICKER_AI_PROVIDER=null
STICKER_AI_IMAGE_MODEL=gpt-image-2
# STICKER_AI_WORKER_BASE_URL=
# STICKER_AI_WORKER_TOKEN=   # from secret manager only — never commit / never log
STICKER_AI_TG_ADMIN_IDS=
STICKER_AI_TG_CHAT_IDS=
STICKER_AI_RATE_PER_MIN=20
STICKER_AI_TENANT_ID=focuspay

# Security / deploy tracking
SECURITY_INTERNAL_IPS=153.80.249.77
SECURITY_TRUSTED_PROXIES=127.0.0.1,::1
EXPOSE_LOCAL_CORS=0
DEPLOY_WEBHOOK_SECRET=

# Nightly SAST self-check (systemd focuspay-sast-selfcheck — not uvicorn)
# BANDIT_BIN=/opt/focuspay-security-tools/bin/bandit
# PIP_AUDIT_BIN=/opt/focuspay-security-tools/bin/pip-audit
# EXCHANGE_ROOT=/opt/exchange-backend
# BOT_ROOT=/opt/tg_bot_btc
# SELFCHECK_ARTIFACT_DIR=/var/lib/focuspay/selfcheck
