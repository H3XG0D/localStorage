[Unit]
Description=FocusPay signer (BTC/LTC payouts)
After=network-online.target

[Service]
Type=simple
User=focuspay-signer
Group=focuspay-signer
EnvironmentFile=/etc/focuspay/signer.env
WorkingDirectory=/opt/focuspay-signer
ExecStart=/opt/focuspay-signer/venv/bin/uvicorn main:app --host 10.8.0.2 --port 9000
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/focuspay-signer

[Install]
WantedBy=multi-user.target
